{
  "version": 2,
  "buildCommand": "node scripts/build-trpc-api.mjs && npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/trpc/[...trpc].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
